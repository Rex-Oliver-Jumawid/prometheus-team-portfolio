# Full canonical URL of the Prometheus page, including /prometheus if applicable.
# Leave unset on previews. Set only on the public production deployment and rebuild.
SEO_HOMEPAGE_URL=

# Prometheus PostHog project token (not a personal API key).
# Set these locally in .env.local and in Vercel, then rebuild.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
